# Copy to .env (git ignores it). Larry reads ./.env and the repository's .env
# on every run; a variable already in the environment wins.

# The cloud: the PostgreSQL server where the conceptions live. Any of the
# three forms works; Azure requires SSL and Larry adds sslmode=require for it.
# LARRY_DB=host=<server>.postgres.database.azure.com port=5432 user=<user> password=<password> dbname=larry
# LARRY_DB=Host=<server>.postgres.database.azure.com;Port=5432;Username=<user>;Password=<password>;Database={0}
# LARRY_DB=postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/larry

# Who is talking (default: the login name). Only a validator decides what is true.
# LARRY_USER=pedro

# The cache file (default: memory/en.atoms in the repository).
# LARRY_MEMORY=/path/to/en.atoms
